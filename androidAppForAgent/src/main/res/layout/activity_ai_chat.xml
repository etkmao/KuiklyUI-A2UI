<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="64dp"
        android:gravity="center_vertical" android:paddingStart="18dp" android:paddingEnd="10dp" android:background="#FFFFFF">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/app_name" android:textSize="20sp" android:textStyle="bold" android:textColor="#18231E" />
            <TextView android:id="@+id/connection" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/disconnected" android:textSize="12sp" android:textColor="#7A8580" android:layout_marginTop="2dp" />
        </LinearLayout>
        <Button android:id="@+id/newSession" android:layout_width="wrap_content" android:layout_height="48dp" android:minWidth="0dp" android:background="?attr/selectableItemBackgroundBorderless" android:text="@string/new_session" android:textColor="#53635A" android:textSize="13sp" />
        <Button android:id="@+id/settings" android:layout_width="wrap_content" android:layout_height="48dp" android:minWidth="0dp" android:background="?attr/selectableItemBackgroundBorderless" android:text="@string/settings" android:textColor="#138A55" android:textSize="13sp" />
    </LinearLayout>
    <TextView android:id="@+id/notice" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" android:background="#FFF6DE" android:textColor="#7B5D27" android:textSize="13sp" android:visibility="gone" />
    <Button android:id="@+id/loadHistory" android:layout_width="match_parent" android:layout_height="40dp" android:background="?attr/selectableItemBackground" android:text="@string/load_history" android:textSize="12sp" android:textColor="#7A8580" android:visibility="gone" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/messages" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:paddingTop="16dp" android:paddingBottom="16dp" />
        <LinearLayout android:id="@+id/emptyState" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center" android:gravity="center" android:orientation="vertical" android:padding="32dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/empty_title" android:textSize="20sp" android:textColor="#33443A" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/empty_description" android:textSize="13sp" android:textColor="#89938D" android:layout_marginTop="10dp" />
            <Button android:id="@+id/offlineDemo" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginTop="22dp" android:text="@string/offline_preview" android:textColor="#138A55" android:background="?attr/selectableItemBackground" />
        </LinearLayout>
        <Button android:id="@+id/jumpBottom" android:layout_width="wrap_content" android:layout_height="44dp" android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="8dp" android:text="@string/latest_messages" android:textColor="#138A55" android:visibility="gone" />
    </FrameLayout>
    <LinearLayout android:id="@+id/editTarget" android:layout_width="match_parent" android:layout_height="40dp" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:background="#EAF4EE" android:visibility="gone">
        <TextView android:id="@+id/editLabel" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="13sp" android:textColor="#3B6650" />
        <Button android:id="@+id/clearTarget" android:layout_width="48dp" android:layout_height="40dp" android:minWidth="0dp" android:text="@string/cancel" android:textSize="12sp" android:background="?attr/selectableItemBackground" />
    </LinearLayout>
    <LinearLayout android:id="@+id/composer" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:gravity="bottom" android:padding="10dp" android:background="#FFFFFF">
        <EditText android:id="@+id/input" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="44dp" android:maxLines="4" android:maxLength="4000" android:inputType="textCapSentences|textMultiLine" android:imeOptions="actionSend" android:hint="@string/input_hint" android:importantForAutofill="no" android:textSize="16sp" android:textColor="#233029" android:textColorHint="#97A099" android:padding="12dp" />
        <Button android:id="@+id/send" android:layout_width="72dp" android:layout_height="44dp" android:layout_marginStart="10dp" android:minWidth="0dp" android:text="@string/send" android:textSize="14sp" android:textColor="#FFFFFF" />
    </LinearLayout>
</LinearLayout>
