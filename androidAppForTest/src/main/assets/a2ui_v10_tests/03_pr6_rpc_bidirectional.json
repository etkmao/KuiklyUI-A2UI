{
  "name": "PR-6 Bidirectional RPC",
  "description": "A2UI v1.0 bidirectional RPC showcase. The agent (1) renders a button whose action is 'callAgentFunction:fetchUser' and (2) immediately asks the renderer to run 'openPage' via callRendererFunction. In the matching test harness, the host inspects both envelopes and replies with rendererFunctionResponse / agentFunctionResponse to close each loop.",
  "messages": [
    {
      "version": "1.0",
      "createSurface": {
        "surfaceId": "pr6-rpc-surface",
        "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
        "dataModel": {
          "status": "idle"
        }
      }
    },
    {
      "version": "1.0",
      "updateComponents": {
        "surfaceId": "pr6-rpc-surface",
        "components": [
          {
            "id": "root",
            "component": "Column",
            "children": ["title", "status-line", "fetch-btn"]
          },
          {
            "id": "title",
            "component": "Text",
            "variant": "h2",
            "text": "PR-6 bidirectional RPC"
          },
          {
            "id": "status-line",
            "component": "Text",
            "text": {
              "@path": "/status"
            }
          },
          {
            "id": "fetch-btn-text",
            "component": "Text",
            "text": "Fetch user from agent"
          },
          {
            "id": "fetch-btn",
            "component": "Button",
            "child": "fetch-btn-text",
            "action": {
              "callAgentFunction": {
                "name": "fetchUser",
                "args": {
                  "id": 42
                },
                "timeoutMs": 5000
              }
            }
          }
        ]
      }
    },
    {
      "version": "1.0",
      "callRendererFunction": {
        "surfaceId": "pr6-rpc-surface",
        "requestId": "demo-req-openpage-0001",
        "name": "openPage",
        "args": {
          "route": "/profile"
        },
        "timeoutMs": 3000
      }
    },
    {
      "version": "1.0",
      "agentFunctionResponse": {
        "surfaceId": "pr6-rpc-surface",
        "requestId": "demo-req-fetchuser-reply-0001",
        "result": {
          "name": "Alice",
          "level": "gold"
        }
      }
    }
  ]
}
