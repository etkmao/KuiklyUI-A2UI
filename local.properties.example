# Copy this file to `local.properties` (which is git-ignored) and adjust
# the values for your local machine. This file must NOT be checked into
# version control.

# Path to the Android SDK.
sdk.dir=/Users/YOUR_USER/Library/Android/sdk

# ─────────────────────────────────────────────────────────────────────────
# Override the location of the external KuiklyUI checkout.
# If unset here, the default from `gradle.properties` (../KuiklyUI)
# is used. Absolute paths recommended for per-machine overrides.
# ─────────────────────────────────────────────────────────────────────────
# kuikly.projectDir=/absolute/path/to/KuiklyUI

# androidAppForAgent debug connection defaults. Keep real values local.
# Credentials must be entered at runtime, never in these properties.
# agent.baseUrl=https://YOUR_AGENT_HOST
# agent.routes={"sessions":"/YOUR_SESSION_PATH","runs":"/YOUR_RUN_PATH/{sessionId}","events":"/YOUR_EVENT_PATH/{sessionId}","snapshot":"/YOUR_SNAPSHOT_PATH/{sessionId}","card":"/YOUR_CARD_PATH/{sessionId}/{cardId}","messages":"/YOUR_MESSAGE_PATH/{sessionId}","cancel":"/YOUR_CANCEL_PATH/{runId}"}
